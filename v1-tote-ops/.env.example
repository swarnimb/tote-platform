# Copy this file to .env and fill in real values.
# Never commit .env — it contains secrets.

# Database (Supabase → Settings → Database → Connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase (Supabase → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=gradeout-pdfs

# Auth
APP_PASSWORD=your-login-password
SESSION_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_hex(32))"

# Invoice recipient
INVOICE_RECIPIENT_EMAIL=recipient@example.com
